{
  "name": "agentmesh",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentmesh": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "pnpm --dir web build",
    "cli": "tsx src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "oxlint src test scripts *.ts",
    "audit:repository": "bash scripts/repository-audit.sh",
    "smoke:compose": "tsx scripts/compose-smoke.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:e2e": "pnpm --dir web test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "@fastify/proxy-addr": "5.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@modelcontextprotocol/fastify": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
