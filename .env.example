# Local-only defaults. Generate a private signing key before exposing AgentMesh remotely.
AGENT_SESSION_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Optional local dashboard authentication. Leave blank to keep the dashboard disabled.
# Generate a private value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AGENTMESH_ADMIN_TOKEN=
# Set to 1 only when the dashboard is served over HTTPS.
AGENTMESH_ADMIN_COOKIE_SECURE=0
POSTGRES_PASSWORD=agentmesh-local-only
AGENTMESH_PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1
