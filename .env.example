# Local-only defaults. Generate a private signing key before exposing AgentMesh remotely.
AGENT_SESSION_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Optional local dashboard authentication. Leave blank to keep the dashboard disabled.
# Generate a private value with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
AGENTMESH_ADMIN_TOKEN=
# Set to 1 only when the dashboard is served over HTTPS.
AGENTMESH_ADMIN_COOKIE_SECURE=0
# Hosted GitHub sign-in is disabled unless this complete group is configured. Generate the
# web auth key separately with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
AGENTMESH_PUBLIC_ORIGIN=
AGENTMESH_WEB_AUTH_KEY=
# Comma-separated immutable numeric GitHub user IDs. Project limit 0 means unlimited.
AGENTMESH_OPERATOR_GITHUB_IDS=
AGENTMESH_PROJECT_LIMIT=
# Optional named connection-token lifetime in days; defaults to 90 when hosted mode is enabled.
AGENTMESH_TOKEN_TTL_DAYS=
# Optional positive per-process abuse-control limits. Defaults and windows:
# OAuth start/callback 20 per 10 minutes per source IP; owner reads 300/minute
# per session; owner mutations 60/minute per session; connection creation 10/hour
# per user; MCP 600/minute per connection token.
AGENTMESH_RATE_LIMIT_OAUTH_START=20
AGENTMESH_RATE_LIMIT_OWNER_READ=300
AGENTMESH_RATE_LIMIT_OWNER_MUTATION=60
AGENTMESH_RATE_LIMIT_CONNECTION_CREATE=10
AGENTMESH_RATE_LIMIT_MCP=600
# Optional comma-separated exact proxy IPs or CIDRs. Leave blank unless AgentMesh is
# behind a pinned, private Caddy address; never use 0.0.0.0/0 or ::/0.
AGENTMESH_TRUSTED_PROXIES=
# Optional observer login for pgAdmin. Run the command above again for a separate value
# of at least 24 characters.
# Observer provisioning supports only a dedicated AgentMesh database and fails closed otherwise.
AGENTMESH_DB_OBSERVER_PASSWORD=
# Used only with compose.pgadmin.yaml; PostgreSQL has no host port in the base Compose file.
AGENTMESH_DB_OBSERVER_PORT=55433
POSTGRES_PASSWORD=agentmesh-local-only
AGENTMESH_PORT=3000
# Public hostname(s); container-only loopback hosts are added internally for healthchecks.
ALLOWED_HOSTS=localhost,127.0.0.1
