# Local-only defaults. Generate a private signing key before exposing AgentMesh remotely.
AGENT_SESSION_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Optional local dashboard authentication. Leave blank to keep the dashboard disabled.
# Generate a private value with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
AGENTMESH_ADMIN_TOKEN=
# Set to 1 only when the dashboard is served over HTTPS.
AGENTMESH_ADMIN_COOKIE_SECURE=0
# Optional observer login for pgAdmin. Run the command above again for a separate value
# of at least 24 characters.
# Observer provisioning supports only a dedicated AgentMesh database and fails closed otherwise.
AGENTMESH_DB_OBSERVER_PASSWORD=
# Used only with compose.pgadmin.yaml; PostgreSQL has no host port in the base Compose file.
AGENTMESH_DB_OBSERVER_PORT=55433
POSTGRES_PASSWORD=agentmesh-local-only
AGENTMESH_PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1
