# Copy to /opt/agentmesh/secrets/agentmesh.env with mode 0600.
# Values are intentionally omitted. Use URL-safe random secrets.
AGENTMESH_IMAGE=
POSTGRES_PASSWORD=
AGENT_SESSION_SIGNING_KEY=
AGENTMESH_ADMIN_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://getagentmesh.dev/auth/github/callback
AGENTMESH_PUBLIC_ORIGIN=https://getagentmesh.dev
AGENTMESH_ALLOWED_HOSTS=getagentmesh.dev,127.0.0.1,localhost
AGENTMESH_WEB_AUTH_KEY=
AGENTMESH_OPERATOR_GITHUB_IDS=
AGENTMESH_PROJECT_LIMIT=5
AGENTMESH_TOKEN_TTL_DAYS=90
AGENTMESH_RATE_LIMIT_INVITE_CAPTURE=30
AGENTMESH_RATE_LIMIT_INVITE_REDEEM=10
AGENTMESH_DB_OBSERVER_PASSWORD=
