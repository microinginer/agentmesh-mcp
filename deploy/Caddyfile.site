agentmesh.uzmedical.org {
	encode zstd gzip

	request_body {
		max_size 64KB
	}

	header {
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@oauth_callback path /auth/github/callback
	skip_log @oauth_callback

	reverse_proxy 127.0.0.1:3100 {
		transport http {
			dial_timeout 3s
			response_header_timeout 15s
		}
	}

	log {
		output file /var/log/caddy/agentmesh-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
